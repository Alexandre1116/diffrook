{
	servers {
		max_header_size 32KB
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
}

{$DIFFROOK_DOMAIN} {
	request_body {
		max_size 2MB
	}
	reverse_proxy diffrook:8080 {
		# Host is preserved by default. Overwrite the untrusted client IP header.
		header_up X-Real-IP {remote_host}
	}
}
