# Copy to .env before changing deployment settings.
OVERSIGHT_BIND_ADDRESS=127.0.0.1
OVERSIGHT_PUBLISHED_PORT=8080
# Each company sets its own externally visible URL. Leave empty for local-only use.
# Example: https://reviews.your-company.example
OVERSIGHT_PUBLIC_URL=
# Empty derives this from OVERSIGHT_PUBLIC_URL. HTTPS requires true.
OVERSIGHT_SECURE_COOKIES=
# Empty defaults to false when SSO is configured, otherwise true.
OVERSIGHT_LOCAL_LOGIN=
OVERSIGHT_SESSION_SECONDS=28800
# Optional signed Freelancer/Teams/Enterprise license (legacy Business files remain valid).
# Mount read-only. Empty uses Individual: 1 user, 3 automations, local sign-in, free forever.
OVERSIGHT_LICENSE_FILE=
# Exact IPs of proxies that OVERWRITE X-Real-IP. Never trust all clients.
OVERSIGHT_TRUSTED_PROXIES=
# Optional OpenID Connect, configured independently by each company.
OVERSIGHT_OIDC_ISSUER_URL=
OVERSIGHT_OIDC_CLIENT_ID=
# Prefer a mounted Docker secret. Configure exactly one secret source.
OVERSIGHT_OIDC_CLIENT_SECRET_FILE=
OVERSIGHT_OIDC_CLIENT_SECRET=
# Exact, comma-separated sub claims. Every allowed identity has administrator access.
OVERSIGHT_OIDC_ALLOWED_SUBJECTS=
# Optional alternative: exact emails, accepted only with email_verified=true.
OVERSIGHT_OIDC_ALLOWED_EMAILS=
# Used by the optional HTTPS Compose overlay.
OVERSIGHT_DOMAIN=
RUST_LOG=oversight=info,tower_http=warn

# Free beta only: individual, freelancer or teams. Stable releases ignore this.
# Settings selections take precedence after the first start.
OVERSIGHT_BETA_PLAN=individual
